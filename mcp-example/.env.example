# Copy to .env (repo root) and fill in only what your experiment needs.
# Never commit the real .env. YAML keeps the workflow; .env keeps secrets
# and machine-local service URLs.

# --- LLM endpoints used by the framework generator + agent -------------------
# Ollama example (local):
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...            # only if you use openai:* models
# EVAL_CRITIC_LLM=ollama:gemma3:12b

# --- Remote streamable-HTTP MCP server (skip for stdio servers) --------------
# MCP_TRANSPORT=streamable_http
# MCP_SERVER_URL=https://mcp.example.com/mcp
# Static headers as a JSON object (include auth only if unavoidable here):
# MCP_HTTP_HEADERS_JSON={"X-Project": "benchmark"}

# --- stdio MCP server (skip for remote servers) ------------------------------
# MCP_COMMAND=npx
# MCP_ARGS_JSON=["-y", "@some-org/some-mcp-server"]
# Comma-separated names of env vars the child server needs, e.g.:
# MCP_ENV_VARS=SOME_API_KEY
# SOME_API_KEY=...               # the actual secret lives only here

# --- Optional resource tracing ------------------------------------------------
# BENCHMARK_RESOURCE_MONITOR=true
# ELECTRICITY_PRICE_EUR_PER_KWH=0.30
