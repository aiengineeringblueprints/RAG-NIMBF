# Minimal runtime environment.
# Keep workflow configuration in YAML and secrets/service URLs here.

# General benchmark config entrypoint used by python main.py.
# Override this per run, or omit it to fall back to the legacy .env matrix.
BENCHMARK_CONFIG_FILE=experiments/full-grid-example.yaml

# Shared Ollama endpoint. Used by generator, critic, and embeddings unless a
# per-role override below is set.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=

# OpenAI-compatible endpoint for vLLM, TGI, LM Studio, or remote model servers.
# OPENAI_COMPAT_BASE_URL=https://optimaise.ddnss.de/v1
# OPENAI_COMPAT_API_KEY=

# Optional per-role URL/API-key overrides. Leave unset to use the shared values.
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_API_KEY=
# LLM_OPENAI_COMPAT_BASE_URL=https://optimaise.ddnss.de/v1
# LLM_OPENAI_COMPAT_API_KEY=
# EVAL_CRITIC_OLLAMA_BASE_URL=http://dgx-spark:11434
# EVAL_CRITIC_OLLAMA_API_KEY=
# EVAL_CRITIC_OPENAI_COMPAT_BASE_URL=https://rtx-server/v1
# EVAL_CRITIC_OPENAI_COMPAT_API_KEY=
# EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_OLLAMA_API_KEY=

# External HTTP RAG systems can keep auth out of YAML/source.
# RAG_SYSTEM_ADAPTER=http
# RAG_HTTP_ENDPOINT_URL=http://localhost:8000/query
# RAG_HTTP_ANSWER_FIELD=answer
# RAG_HTTP_CONTEXTS_FIELD=contexts
# RAG_HTTP_METADATA_FIELD=metadata
# RAG_HTTP_TIMINGS_FIELD=timings
# RAG_HTTP_AUTH_HEADER=Authorization
# RAG_HTTP_AUTH_VALUE=Bearer ${RAG_API_TOKEN}
# RAG_HTTP_HEADERS={"X-Project":"benchmark"}
# RAG_ADAPTER_MODULES=my_package.my_adapter

# MCP-backed system. Use context mode to benchmark MCP retrieval plus the same
# generator as internal RAG, or answer mode when the MCP tool returns the final
# answer itself. Put credentials in named environment variables and expose only
# those names through MCP_ENV_VARS; do not put secret values in YAML.
# RAG_SYSTEM_ADAPTER=mcp
# MCP_TRANSPORT=streamable_http
# MCP_SERVER_URL=http://localhost:8000/mcp
# MCP_TOOL_NAME=search
# MCP_QUESTION_ARGUMENT=query
# MCP_TOP_K_ARGUMENT=top_k
# MCP_RESULT_MODE=context
# MCP_RESULT_FIELD=contexts
# MCP_TIMEOUT_SECONDS=60
# MCP_EXECUTION_MODE=fixed
# MCP_ALLOWED_TOOLS_JSON=["search","lookup"]
# MCP_MAX_AGENT_ROUNDS=4
# MCP_MAX_RETRIES=1
# MCP_RETRY_BACKOFF_SECONDS=0.25
# MCP_CONTINUE_ON_ERROR=true
# MCP_CORPUS_PATH=datasets/northstar_facilities/corpus
# MCP_ENFORCE_FAIRNESS=true
# MCP_ENV_VARS=SEARCH_API_KEY
# MCP_HTTP_HEADERS_JSON={"Authorization":"Bearer local-dev-token"}

# Managed external RAG systems (dataset ingestion + retrieval + generation).
# The YAML manifest selects the adapter and sweep values; this file supplies
# machine-local connectivity and names the environment variable holding the
# credential. Never put the credential itself in an experiment manifest.
# RAG_MANAGED_BASE_URL=http://spark:8011
# RAG_MANAGED_API_KEY_ENV=OPTIMAISE_RAG_API_KEY
# OPTIMAISE_RAG_API_KEY=
# RAG_MANAGED_REQUEST_TIMEOUT_SECONDS=60
# RAG_MANAGED_POLL_INTERVAL_SECONDS=2
# RAG_MANAGED_POLL_TIMEOUT_SECONDS=1800
# RAG_MANAGED_REUSE_RESOURCES=true
# RAG_MANAGED_CLEANUP=false
# RAG_MANAGED_DATASET_PREFIX=northstar-benchmark

# Local JSONL/CSV datasets for quick external-RAG evaluation.
# DATASET_NAME=jsonl
# DATASET_PATH=examples/sample_dataset.jsonl
# DATASET_CORPUS_PATH=datasets/northstar_facilities/corpus
# DATASET_QUESTION_FIELD=question
# DATASET_GROUND_TRUTH_FIELD=ground_truth
# DATASET_CONTEXT_FIELD=context
# DATASET_METADATA_FIELD=metadata

# Generic HuggingFace dataset adapter (any dataset with simple string columns).
# Skips dedicated adapter registration; useful for one-off / custom HF datasets.
# DATASET_NAME=hf-generic
# DATASET_HF_ID=rajpurkar/squad
# DATASET_SPLIT=validation
# DATASET_SUBSET=                                 # only set if the dataset needs a config
# DATASET_QUESTION_FIELD=question
# DATASET_GROUND_TRUTH_FIELD=answers              # complex fields (dict/list) handled per-adapter
# DATASET_CONTEXT_FIELD=context
#
# Examples:
#   TriviaQA:   DATASET_HF_ID=mandarjoshi/trivia_qa  DATASET_CONTEXT_FIELD=context
#   TruthfulQA: DATASET_HF_ID=truthful_qa/truthful_qa DATASET_GROUND_TRUTH_FIELD=correct_answer

# Generic multi-hop dataset adapter (HotpotQA / 2WikiMultiHopQA / MuSiQue / etc.).
# Flattens list[list[str]] contexts, preserves supporting_facts in metadata for
# downstream faithfulness scoring, and deduplicates paragraphs into a shared corpus.
# DATASET_NAME=multihop-generic
# DATASET_HF_ID=hotpotqa/hotpot_qa
# DATASET_SUBSET=distractor                        # required for HotpotQA — 'distractor' or 'fullwiki'
# DATASET_SPLIT=validation
# DATASET_QUESTION_FIELD=question
# DATASET_GROUND_TRUTH_FIELD=answer
#
# Examples:
#   HotpotQA:          DATASET_HF_ID=hotpotqa/hotpot_qa
#                      DATASET_SUBSET=distractor   # mandatory
#   2WikiMultiHopQA:   DATASET_HF_ID=alielfilali01/2WikiMultiHopQA
#                      DATASET_SPLIT=test
#   MuSiQue:           DATASET_HF_ID=dgslibisey/MuSiQue
#                      DATASET_GROUND_TRUTH_FIELD=answer


# Disable expensive model-based metrics for endpoint smoke tests.
# RAGAS_ENABLED=false
# CUSTOM_METRICS_ENABLED=false

# Optional integrated LLM load test. It uses the generator LLM, endpoint,
# questions, and MAX_NEW_TOKENS of the current RAG configuration. Every number
# means that many distinct dataset questions are run once sequentially and once
# concurrently. Identical LLM endpoint/token configurations are measured once.
# LLM_PERFORMANCE_ENABLED=true
# LLM_PERFORMANCE_SOURCE=generation
# LLM_PERFORMANCE_CALL_COUNTS=1,3,6,10
# LLM_PERFORMANCE_WARMUP=true
# LLM_PERFORMANCE_TIMEOUT_SECONDS=60
#
# SOURCE=generation reuses the actual RAG answer calls and adds no requests.
# SOURCE=load_test runs the additional sequential/parallel load profiles.

# MLflow tracking and MLflow-specific runtime toggles stay in env.
# Provider credentials expected by MLflow should also stay here.
MLFLOW_TRACKING_URI=mlruns
# OPENAI_API_KEY=

# ClearML remote execution. These configure ClearML itself, not the benchmark
# matrix. The ClearML task publishes only non-secret BenchmarkConfig fields.
# CLEARML_WEB_HOST=http://localhost:8080
# CLEARML_API_HOST=http://localhost:8008
# CLEARML_FILES_HOST=http://localhost:8081
# CLEARML_API_ACCESS_KEY=
# CLEARML_API_SECRET_KEY=

# LangFuse tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# Legacy fallback: if BENCHMARK_CONFIG_FILE is unset, config.py still accepts the
# old .env matrix variables such as LLM_MODELS, EMBEDDING_MODELS, CHUNK_SIZES,
# DATASET_NAME, RETRIEVAL_TOP_K, PROMPT_TEMPLATES, and RERANKER_MODELS.
